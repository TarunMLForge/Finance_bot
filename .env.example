# Atlas AI Financial Assistant Configuration Template

# Application Environment
APP_NAME="Atlas AI Financial Assistant"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Telegram Bot
# Obtain via @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Set to 'webhook' for production or 'polling' for local development
TELEGRAM_MODE="polling"
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# AI Engine (Groq AI - Free Tier)
# Free API key from https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_VISION_MODEL="qwen/qwen3.6-27b"
GROQ_AUDIO_MODEL="whisper-large-v3"

# AI Engine Fallback (Optional - Google Gemini)
# Free tier key from https://aistudio.google.com/
GEMINI_API_KEY=""

# Database (MongoDB)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="atlas_financial_assistant"

# Financial Data APIs
# Finnhub API Key (Free tier at https://finnhub.io/)
FINNHUB_API_KEY="your_finnhub_api_key_here"
# SEC EDGAR requires a User-Agent in the format 'User-Agent: Sample Company Name AdminContact@<sample company domain>.com'
SEC_USER_AGENT="AtlasFinancialAssistant/1.0 (contact@atlasfinance.ai)"

# Proactive Scheduler Settings
DEFAULT_BRIEF_TIME="08:00"
DEFAULT_TIMEZONE="UTC"
MARKET_ALERT_THRESHOLD_PCT=5.0
